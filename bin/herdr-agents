#!/bin/sh
# Cross-machine agent rollup. Herdr's sidebar is per-server, so this is the
# one view it does not give you: every agent on every host, in one list.
# Answers "which agent is blocked waiting for me?" without attaching to each.
set -eu

HOSTS="${HERDR_REMOTE_HOSTS:-quicopt simulations_tb quicoptapi tryquicoptapi}"
FEED_STATE="$HOME/.cache/herdr-agent-feed.json"

fmt='
import sys, json, os
host = sys.argv[1]
# Panes the agent feed reports into. Their state is a mirror of a remote that
# this rollup lists on its own row, so counting them here would double every
# machine. A pane not in this set is a genuine local agent and still shows.
mirrored = set()
if len(sys.argv) > 2:
    try:
        mirrored = set(json.load(open(os.path.expanduser(sys.argv[2]))))
    except Exception:
        pass
try:
    agents = json.load(sys.stdin)["result"]["agents"]
except Exception:
    print("  %-16s (no server running)" % host); sys.exit()
agents = [a for a in agents if a.get("pane_id") not in mirrored]
if not agents:
    print("  %-16s -" % host)
for a in agents:
    # Fields are agent_status / terminal_title_stripped -- "status" and "name"
    # do not exist and silently rendered every live agent as "?  ?".
    label = a.get("terminal_title_stripped") or a.get("agent") or "?"
    print("  %-16s %-9s %s" % (host, a.get("agent_status", "?"), label))
'

echo "HOST             STATUS    AGENT"
herdr agent list 2>/dev/null | python3 -c "$fmt" "local(mac)" "$FEED_STATE" \
    || echo "  local(mac)       (no server)"
for h in $HOSTS; do
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$h" \
        '~/.local/bin/herdr agent list' 2>/dev/null | python3 -c "$fmt" "$h" \
        || echo "  $h unreachable"
done
