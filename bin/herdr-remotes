#!/usr/bin/env python3
"""One Herdr workspace per machine: Mac, plus one per remote host.

Each remote runs its own herdr server, so its panes survive independently of
this Mac -- a dropped VPN kills only the client here, not the work over there.

Idempotent by design. A server restart (e.g. at login) restores the workspace
shape but NOT the processes in the panes, leaving idle shells. Running this
again reattaches them in place instead of creating duplicates.

Each pane runs herdr-reconnect rather than `herdr --remote` directly, so an ssh
drop (a closed laptop, a network blip) reattaches by itself instead of leaving a
dead pane. Disconnecting therefore has to kill the supervisor too, not just the
client it is watching.

Requires [experimental] allow_nested = true in ~/.config/herdr/config.toml, or
the nested-launch guard rejects `herdr --remote` inside a pane.
"""
import json
import os
import subprocess
import sys

ALL_HOSTS = os.environ.get(
    "HERDR_REMOTE_HOSTS", "quicopt simulations_tb quicoptapi tryquicoptapi"
).split()
LOCAL = "Mac"

USAGE = """usage: herdr-remotes [--tabs-only|--disconnect] [host ...]

  (no args)     ensure a workspace per machine and attach all remotes
  host ...      attach only the named hosts; other workspaces are left alone
  --tabs-only   create the workspaces but attach nothing
  --disconnect  drop the connection to the named hosts (or all). The remote
                server and everything running on it keep going -- this only
                closes the viewer on this Mac.

Each machine gets its own workspace in the spaces sidebar. The Mac workspace is
local and is never attached to anything.

Hosts: """ + " ".join(ALL_HOSTS)


def raw(*args):
    """Run a herdr command that does not emit JSON (status, pane run)."""
    out = subprocess.run(["herdr", *args], capture_output=True, text=True)
    if out.returncode != 0:
        raise SystemExit(f"herdr {' '.join(args)} failed: {out.stderr.strip()}")
    return out.stdout


def herdr(*args):
    """Run a herdr command that emits a JSON envelope, returning .result."""
    return json.loads(raw(*args))["result"]


def workspaces():
    return {w["label"]: w["workspace_id"]
            for w in herdr("workspace", "list")["workspaces"]}


def root_pane(ws_id):
    """First pane of a workspace, in pane order."""
    panes = herdr("pane", "list", "--workspace", ws_id)["panes"]
    return panes[0]["pane_id"] if panes else None


def pane_procs(pane_id):
    try:
        info = herdr("pane", "process-info", "--pane", pane_id)
    except SystemExit:
        return []
    return info["process_info"]["foreground_processes"]


def attach_pids(pane_id, host):
    """PIDs to kill to detach this host, supervisor first.

    Killing the client alone is not enough -- herdr-reconnect would read that as
    a dropped link and reattach immediately. Matched exactly at the end of the
    command line: a substring match on the host would make `quicopt` also hit
    `quicoptapi`.
    """
    supervisor, client = [], []
    for proc in pane_procs(pane_id):
        cmd = proc["cmdline"].strip()
        if cmd.endswith(f"herdr-reconnect {host}"):
            supervisor.append(proc["pid"])
        elif cmd == f"herdr --remote {host}":
            client.append(proc["pid"])
    return supervisor + client


def connected(pane_id, host):
    """A pane counts as connected while its supervisor lives, including mid-
    backoff, so re-running this script never stacks a second one on top."""
    for proc in pane_procs(pane_id):
        cmd = proc["cmdline"]
        if "remote-client-bridge" in cmd:
            return True
        if cmd.strip().endswith(f"herdr-reconnect {host}"):
            return True
    return False


def main():
    argv = sys.argv[1:]
    if "-h" in argv or "--help" in argv:
        print(USAGE)
        return
    tabs_only = "--tabs-only" in argv
    disconnect = "--disconnect" in argv
    wanted = [a for a in argv if not a.startswith("-")]
    unknown = [h for h in wanted if h not in ALL_HOSTS]
    if unknown:
        raise SystemExit(f"unknown host(s): {' '.join(unknown)}\n{USAGE}")
    hosts = wanted or ALL_HOSTS

    if "running" not in raw("status", "server"):
        raise SystemExit("herdr server not running -- start it with 'herdr'")

    spaces = workspaces()

    if disconnect:
        for host in hosts:
            ws = spaces.get(host)
            pane = root_pane(ws) if ws else None
            pids = attach_pids(pane, host) if pane else []
            if not pids:
                print(f"  {host:<16} not connected")
                continue
            for pid in pids:
                try:
                    os.kill(pid, 15)
                except ProcessLookupError:
                    pass
            print(f"  {host:<16} disconnected (remote server still running)")
        return

    # The Mac's own workspace: local work, never attached to anything.
    if LOCAL not in spaces:
        res = herdr("workspace", "create", "--cwd", os.path.expanduser("~"),
                    "--label", LOCAL, "--no-focus")
        print(f"  {LOCAL:<16} {res['workspace']['workspace_id']}  created (local)")

    for host in ALL_HOSTS:
        ws = spaces.get(host)
        if ws is None:
            res = herdr("workspace", "create", "--label", host, "--no-focus")
            ws = res["workspace"]["workspace_id"]
            pane = res["root_pane"]["pane_id"]
        else:
            pane = root_pane(ws)
            if pane is None:
                print(f"  {host:<16} {ws}  workspace has no pane; skipped")
                continue
            if connected(pane, host):
                print(f"  {host:<16} {ws}  already connected")
                continue

        if tabs_only or host not in hosts:
            print(f"  {host:<16} {ws}  workspace ready (not attached)")
            continue
        raw("pane", "run", pane, f"herdr-reconnect {host}")
        print(f"  {host:<16} {ws}  attaching")


if __name__ == "__main__":
    sys.exit(main())
